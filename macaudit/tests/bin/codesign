#!/bin/bash
# tests/bin/codesign — PATH-shim used by the integration-tier3-anomalies
# bats suite (scenario 16.16) to force `codesign --verify ...` to
# return a configurable exit status without touching the real macOS
# codesign binary.
#
# The shim returns:
#   * `${MACAUDIT_BATS_CODESIGN_RC}` (integer) when that env var is set.
#   * 0 otherwise.
#
# A canned stderr line can be injected via MACAUDIT_BATS_CODESIGN_STDERR
# so the XProtect anomaly's `stderr_first_line` is deterministic.
#
# The shim deliberately accepts every invocation shape the real
# codesign understands — only the exit code is synthesised.

set -u

if [ -n "${MACAUDIT_BATS_CODESIGN_STDERR:-}" ]; then
  printf '%s\n' "${MACAUDIT_BATS_CODESIGN_STDERR}" >&2
fi

exit "${MACAUDIT_BATS_CODESIGN_RC:-0}"
